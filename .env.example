# Configuração do bot do Telegram (copie para .env e preencha).
# Carregue antes de rodar `inv-bot`, ex.: `set -a; . ./.env; set +a`

# Token do bot, obtido com o @BotFather no Telegram. Obrigatório.
INV_TELEGRAM_TOKEN=123456789:ABCdefGhIjKlMnOpQrStUvWxYz

# Allowlist: IDs numéricos do Telegram que podem usar o bot (você e sua esposa).
# Separe por vírgula. Recomendado — sem isso, qualquer um que achar o bot tem acesso.
# Para descobrir seu ID, fale com o bot @userinfobot ou envie qualquer mensagem
# ao seu bot sem allowlist: ele responde com o seu ID.
INV_ALLOWED_USERS=11111111,22222222

# Opcional: caminhos do catálogo e do banco (padrões abaixo).
# INV_CATALOG=data/items.yaml
# INV_DB=data/inventory.db

# Opcional: habilita o fallback de interpretação via Claude quando o parser de
# regras fica em dúvida. Requer instalar o extra: pip install -e ".[llm]"
# ANTHROPIC_API_KEY=sk-ant-...
# INV_LLM_MODEL=claude-opus-4-8
